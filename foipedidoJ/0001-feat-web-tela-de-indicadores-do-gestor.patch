+import { keepPreviousData, useQuery } from '@tanstack/react-query'
+import { useEffect, useState } from 'react'
+import { useSearchParams } from 'react-router'
+import type { components } from '../../shared/api/generated/schema'
+import { http } from '../../shared/api/http'
+import { ApiError } from '../../shared/api/problem-details'
+import { CampoSelecao } from '../../shared/ui/CampoSelecao'
+import { Campo } from '../../shared/ui/Campo'
+import { Botao } from '../../shared/ui/Botao'
+import { Alerta } from '../../shared/ui/Alerta'
+import { Cartao } from '../../shared/ui/Cartao'
+import { SeloRisco } from './PedidosFila'
+import { filasEquipeOptions } from './api'
+import { hojeRecife, periodo, validarPeriodo, rotuloDia } from './periodo-indicadores'
+import './indicadores.css'
+
+type Saida = components['schemas']['IndicadoresSaida']
+const inteiro = (n: number) => n.toLocaleString('pt-BR')
+const decimal = (n: number | null) => n === null ? '—' : n.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
+const percentual = (n: number | null) => n === null ? '—' : `${decimal(n * 100)}%`
+function CartaoNumero({ titulo, valor, ajuda }: { titulo: string; valor: string; ajuda: string }) {
+  return <Cartao><h2>{titulo}</h2><p className="indicador-numero">{valor}</p><p>{ajuda}</p></Cartao>
+}
+export default function Indicadores() {
+  const [params, setParams] = useSearchParams()
+  const padrao = periodo('4')
+  const de = params.get('de') ?? padrao.de
+  const ate = params.get('ate') ?? padrao.ate
+  const fila = params.get('fila') ?? ''
+  const [modo, setModo] = useState(params.has('de') ? 'personalizado' : '4')
+  const [inicio, setInicio] = useState(de)
+  const [fim, setFim] = useState(ate)
+  const [erroLocal, setErroLocal] = useState('')
+  const chaveUrl = `${de}/${ate}/${fila}`
+  const [urlAnterior, setUrlAnterior] = useState(chaveUrl)
+  if (urlAnterior !== chaveUrl) {
+    setUrlAnterior(chaveUrl)
+    setInicio(de)
+    setFim(ate)
+    setErroLocal('')
+    const preset = ['4', '8', 'mes'].find((tipo) => { const p = periodo(tipo); return p.de === de && p.ate === ate })
+    setModo(preset ?? 'personalizado')
+  }
+  const [agora, setAgora] = useState(Date.now)
+  const mesComUmDia = de === ate && de === hojeRecife() && de.endsWith('-01')
+  const erroPeriodo = mesComUmDia ? '' : validarPeriodo(de, ate)
+  const filaValida = !fila || /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(fila)
+  const filas = useQuery({ ...filasEquipeOptions, refetchOnWindowFocus: false, refetchOnReconnect: false })
+  const consulta = useQuery({
+    queryKey: ['indicadores', de, ate, fila],
+    queryFn: ({ signal }) => {
+      const busca = new URLSearchParams({ de, ate })
+      if (fila) busca.set('fila_id', fila)
+      return http.request<Saida>(`/equipe/indicadores?${busca}`, { signal })
+    },
+    enabled: !erroPeriodo && filaValida,
+    placeholderData: keepPreviousData,
+    refetchOnWindowFocus: false, refetchOnReconnect: false, retry: false,
+  })
+  const falha = consulta.error instanceof ApiError ? consulta.error : undefined
+  const retry = falha?.response.headers.get('Retry-After')
+  const espera = retry ? (/^\d+$/.test(retry) ? consulta.errorUpdatedAt + Number(retry) * 1000 : Date.parse(retry)) : 0
+  const bloqueado = Boolean(consulta.isError && espera > agora)
+  useEffect(() => {
+    if (!bloqueado) return
+    const timer = setInterval(() => setAgora(Date.now()), 250)
+    return () => clearInterval(timer)
+  }, [bloqueado])
+  function aplicar(a: string, b: string, f = fila, diaUnicoDoMes = false) {
+    const erro = diaUnicoDoMes && a === b && a === hojeRecife() && a.endsWith('-01') ? '' : validarPeriodo(a, b)
+    setErroLocal(erro)
+    if (erro) return
+    setParams({ de: a, ate: b, ...(f ? { fila: f } : {}) })
+  }
+  const dados = consulta.data
+  const t = dados?.totais
+  const semMovimento = t && ![t.solicitacoes_criadas, t.confirmadas, t.recusadas, t.expiradas, t.realizadas, t.faltas, t.vagas_ofertadas, t.desistencias].some(Boolean)
+  const erroFiltro = erroLocal || erroPeriodo || (falha?.problem.status === 422 ? 'Confira o período informado (até 366 dias).' : '')
+  return <section className="indicadores"><h1>Indicadores</h1><p>Acompanhe os movimentos das filas do seu escopo.</p>
+    <div className="indicadores-filtros">
+      <CampoSelecao rotulo="Período" value={modo} onChange={(e) => {
+        setModo(e.target.value)
+        if (e.target.value !== 'personalizado') { const p = periodo(e.target.value); setInicio(p.de); setFim(p.ate); aplicar(p.de, p.ate, fila, e.target.value === 'mes') }
