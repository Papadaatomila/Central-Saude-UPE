+      <CampoSelecao rotulo="Fila" value={fila} disabled={filas.isPending || filas.isError} onChange={(e) => aplicar(de, ate, e.target.value, mesComUmDia)}>
+        <option value="">Todas as minhas filas</option>{filas.data?.map((f) => <option key={f.id} value={f.id}>{f.unidade_sigla} · {f.nome}</option>)}
+      </CampoSelecao>
+    </div>
+    {modo === 'personalizado' && <form className="indicadores-filtros" onSubmit={(e) => { e.preventDefault(); aplicar(inicio, fim) }}>
+      <Campo rotulo="De" type="date" value={inicio} max={hojeRecife()} onChange={(e) => setInicio(e.target.value)} erro={erroFiltro || undefined} />
