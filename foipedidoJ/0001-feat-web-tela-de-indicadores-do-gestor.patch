+      <Botao type="submit">Aplicar</Botao>
+    </form>}
+    {erroFiltro && <Alerta>{erroFiltro}</Alerta>}{!filaValida && <Alerta>Confira a fila informada no endereço.</Alerta>}
+    {filas.isError && <Alerta>Não foi possível carregar as filas. <Botao onClick={() => void filas.refetch()}>Carregar filas</Botao></Alerta>}
+    {consulta.isPending && !erroPeriodo && filaValida && <p role="status">Carregando indicadores…</p>}
+    {consulta.isError && <Alerta>{falha?.problem.status === 403 ? 'Indicadores indisponíveis para este acesso.' : falha?.problem.status === 404 ? 'Fila não encontrada ou indisponível para este acesso.' : falha?.message ?? 'Não foi possível carregar os indicadores.'}
+      <Botao disabled={bloqueado} onClick={() => { setAgora(Date.now()); void consulta.refetch() }}>Tentar novamente</Botao>{bloqueado && <p>Aguarde o prazo para tentar novamente.</p>}
+    </Alerta>}
+    {dados && <div aria-busy={consulta.isFetching} className={consulta.isFetching ? 'indicadores-atualizando' : undefined}>
+      <p role="status">{consulta.isFetching ? 'Atualizando indicadores…' : `Indicadores de ${rotuloDia(dados.de)} a ${rotuloDia(dados.ate)}, ${dados.fila_id ? filas.data?.find((f) => f.id === dados.fila_id)?.nome ?? 'fila selecionada' : 'todas as filas'}`}</p>
+      {semMovimento && <p>Nenhum movimento neste período.</p>}
+      <div className="indicadores-cartoes">
+        <CartaoNumero titulo="Taxa de confirmação" valor={percentual(dados.totais.taxa_confirmacao)} ajuda={dados.totais.taxa_confirmacao === null ? 'sem dados no período' : 'Confirmadas ÷ propostas encerradas, pela data da proposta.'} />
+        <CartaoNumero titulo="Taxa de faltas" valor={percentual(dados.totais.taxa_faltas)} ajuda={dados.totais.taxa_faltas === null ? 'sem dados no período' : 'Faltas ÷ atendimentos realizados e faltas, pela data da vaga.'} />
+        <CartaoNumero titulo="Tempo de espera" valor={`${decimal(dados.tempo_de_espera.mediana_dias)} dias (mediana) · ${decimal(dados.tempo_de_espera.p90_dias)} dias (P90)`} ajuda={`${inteiro(dados.tempo_de_espera.confirmacoes)} confirmações usadas. Da entrada na fila à primeira confirmação no período.${dados.tempo_de_espera.mediana_dias === null ? ' sem dados no período' : ''}`} />
+        <CartaoNumero titulo="Vagas reaproveitadas" valor={inteiro(dados.totais.vagas_reaproveitadas)} ajuda="Proposta desfeita e depois confirmada por outro pedido." />
+        <CartaoNumero titulo="Vagas perdidas" valor={inteiro(dados.totais.vagas_perdidas)} ajuda="Vagas ofertadas já iniciadas sem agendamento confirmado, realizado ou com falta." />
+        <CartaoNumero titulo="Pedidos criados" valor={inteiro(dados.totais.solicitacoes_criadas)} ajuda="Pedidos criados no período escolhido." />
+        <CartaoNumero titulo="Desistências" valor={inteiro(dados.totais.desistencias)} ajuda="Desses pedidos, os cancelados pelo paciente com motivo." />
+      </div>
+      <h2>Fila agora</h2><p>Não depende do período escolhido.</p><ul className="indicadores-riscos">{(['VERMELHO', 'AMARELO', 'VERDE'] as const).map((r) => <li key={r}><SeloRisco valor={r} /> {inteiro(dados.fila_atual[r] ?? 0)}</li>)}</ul>
+      <h2>Semana a semana</h2><p>Pedidos criados e consultas confirmadas. Confirmações agrupadas pela data da proposta.</p>
+      <div className="indicadores-grafico" role="img" aria-label={`Pedidos criados e consultas confirmadas em ${dados.semanas.length} semanas. Valores disponíveis em Ver tabela.`}>
+        {dados.semanas.map((s) => { const max = Math.max(1, ...dados.semanas.flatMap((x) => [x.solicitacoes_criadas, x.confirmadas])); return <div className="indicadores-semana" key={s.semana}><div className="indicadores-barras"><span title={`Pedidos: ${s.solicitacoes_criadas}`} style={{ height: `${s.solicitacoes_criadas / max * 100}%` }} /><span title={`Confirmadas: ${s.confirmadas}`} style={{ height: `${s.confirmadas / max * 100}%` }} /></div><span>{rotuloDia(s.semana)}</span></div> })}
+      </div><p>Azul: pedidos criados · Verde: consultas confirmadas</p>
+      <details><summary>Ver tabela</summary><div className="indicadores-tabela"><table><caption>Movimento semanal das filas</caption><thead><tr><th scope="col">Semana</th><th scope="col">Pedidos criados</th><th scope="col">Consultas confirmadas</th></tr></thead><tbody>{dados.semanas.map((s) => <tr key={s.semana}><th scope="row">{rotuloDia(s.semana)}</th><td>{inteiro(s.solicitacoes_criadas)}</td><td>{inteiro(s.confirmadas)}</td></tr>)}</tbody></table></div></details>
+    </div>}
+  </section>
+}
