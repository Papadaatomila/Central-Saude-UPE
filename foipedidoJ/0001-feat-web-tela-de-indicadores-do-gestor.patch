@@ -0,0 +1,16 @@
+import { describe, expect, it } from 'vitest'
+import { hojeRecife, periodo, validarPeriodo, rotuloDia } from './periodo-indicadores'
+describe('Indicadores — datas civis em Recife', () => {
+  it('usa o dia anterior durante a virada UTC', () => expect(hojeRecife(new Date('2026-11-01T02:59:59Z'))).toBe('2026-10-31'))
+  it('calcula 28 e 56 dias inclusivos e o mês', () => {
+    expect(periodo('4', '2026-11-01')).toEqual({ de: '2026-10-05', ate: '2026-11-01' })
+    expect(periodo('8', '2026-11-01')).toEqual({ de: '2026-09-07', ate: '2026-11-01' })
+    expect(periodo('mes', '2026-11-07')).toEqual({ de: '2026-11-01', ate: '2026-11-07' })
+  })
+  it('rejeita datas inexistentes, futuras, invertidas e mais de 366 dias', () => {
+    for (const [de, ate] of [['2026-02-30', '2026-03-02'], ['2026-11-02', '2026-11-01'], ['2026-01-01', '2027-01-03']]) expect(validarPeriodo(de!, ate!, '2027-12-31')).not.toBe('')
+    expect(validarPeriodo('2026-01-01', '2026-11-08', '2026-11-07')).not.toBe('')
+    expect(validarPeriodo('2024-01-01', '2024-12-31', '2026-11-07')).toBe('')
+    expect(rotuloDia('2026-11-02')).toBe('02/11')
+  })
+})
diff --git a/apps/web/src/pages/equipe/periodo-indicadores.ts b/apps/web/src/pages/equipe/periodo-indicadores.ts
new file mode 100644
index 0000000..37f3edb
--- /dev/null
+++ b/apps/web/src/pages/equipe/periodo-indicadores.ts
@@ -0,0 +1,20 @@
+export function hojeRecife(agora = new Date()) {
+  const partes = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Recife', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(agora)
+  const parte = (nome: string) => partes.find((p) => p.type === nome)!.value
+  return `${parte('year')}-${parte('month')}-${parte('day')}`
+}
+export const rotuloDia = (dia: string) => `${dia.slice(8, 10)}/${dia.slice(5, 7)}`
+export function periodo(tipo: string, hoje = hojeRecife()) {
+  const fim = new Date(`${hoje}T12:00:00Z`)
+  if (tipo === 'mes') return { de: `${hoje.slice(0, 7)}-01`, ate: hoje }
+  fim.setUTCDate(fim.getUTCDate() - (tipo === '8' ? 55 : 27))
+  return { de: fim.toISOString().slice(0, 10), ate: hoje }
+}
+export function validarPeriodo(de: string, ate: string, hoje = hojeRecife()) {
+  const valida = (d: string) => /^\d{4}-\d{2}-\d{2}$/.test(d) && Number.isFinite(Date.parse(d)) && new Date(d).toISOString().slice(0, 10) === d
+  if (!valida(de) || !valida(ate)) return 'Informe datas válidas.'
+  if (de >= ate) return 'A data inicial deve ser anterior à final.'
+  if (ate > hoje) return 'O período deve terminar até hoje.'
+  if ((Date.parse(ate) - Date.parse(de)) / 86400000 >= 366) return 'Escolha um período de até 366 dias.'
+  return ''
+}
