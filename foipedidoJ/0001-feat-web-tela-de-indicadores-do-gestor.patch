+)
+beforeAll(() => servidor.listen({ onUnhandledFrame: 'error' }))
+afterAll(() => servidor.close())
+beforeEach(() => { chamadas = []; http.iniciarSessao() })
+afterEach(() => servidor.resetHandlers())
+function Voltar() { const navegar = useNavigate(); return <button onClick={() => void navegar(-1)}>Voltar no histórico</button> }
+function abrir() { return render(<QueryClientProvider client={criarQueryClient()}><MemoryRouter initialEntries={['/equipe/indicadores?de=2026-10-01&ate=2026-11-07']}><Indicadores /><Voltar /></MemoryRouter></QueryClientProvider>) }
+it('formata cartões, nulos, riscos, gráfico e tabela sem violações axe', async () => {
